{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YT Music",
  "version": "0.2.0",
  "identifier": "io.github.neverh8me.ytmusic",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YT Music",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#0b0b0e",
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=HardwareMediaKeyHandling --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "neverh8me",
    "copyright": "GPL-3.0. Unofficial; not affiliated with Google LLC.",
    "category": "Music",
    "shortDescription": "Fast unofficial YouTube Music client",
    "longDescription": "A fast, unofficial YouTube Music client written in Rust: search, streaming, library, lyrics and offline downloads.",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
